{
  "name": "car-build-bay",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive 3D car you can pull apart, rebuild, and watch working",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "@types/three": "0.128.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
